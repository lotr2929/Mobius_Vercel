{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mobius AI",
  "mainBinaryName": "Mobius AI",
  "version": "0.2.0",
  "identifier": "com.mobius.desktop",
  "build": {
    "frontendDist": "../www"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "url": "index.html",
        "title": "Mobius AI",
        "width": 1100,
        "height": 820,
        "minWidth": 420,
        "minHeight": 520,
        "resizable": true,
        "backgroundColor": "#e2dccd"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Boon Lay Ong",
    "shortDescription": "Mobius AI - personal AI with perfect memory",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}

