# Mobius — environment variables
# Copy to .env and fill in from C:\_myProjects\.master-env.var

PORT=3005

# Free cloud models (cascade order: Gemini, Mistral, Cerebras, Groq)
GEMINI_API_KEY=
MISTRAL_API_KEY=
CEREBRAS_API_KEY=
GROQ_API_KEY=

# Web search
TAVILY_API_KEY=

# Supabase (memory)
SUPABASE_URL=
SUPABASE_KEY=

# Google Drive (optional). Locally the service-account file in the repo root is used;
# on Vercel put the whole JSON on one line here.
# GOOGLE_SERVICE_ACCOUNT_JSON=
# DRIVE_FOLDER_ID=

# Vercel cron protection (optional)
# CRON_SECRET=

# Site login (Vercel only): passkeys, i.e. fingerprint on the phone and Windows Hello PIN on the laptop.
# Login is switched on by SESSION_SECRET; leave both out locally and localhost stays open.
# SESSION_SECRET=   (long random string)
# SETUP_CODE=       (one-time code for registering a new device at /login.html)
