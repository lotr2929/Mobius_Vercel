# Mobius — environment variables
# Copy to .env and fill in values from .master-env.var

PORT=3005

# AI cascade
GEMINI_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=

# Web search
TAVILY_API_KEY=

# Supabase (cross-device sync)
SUPABASE_URL=
SUPABASE_KEY=

# Local SQLite fallback paths (used when Supabase unavailable)
LOCAL_DB_PATH=./data/mobius.db
DOCS_DB_PATH=./data/docs.db
